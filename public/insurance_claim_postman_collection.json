{
  "info": {
    "_postman_id": "b3e94a81-91d4-4e4b-b0b3-f661a5e305e9",
    "name": "Project 29 - Insurance Claim Management APIs",
    "description": "Postman API Collection for Indian College 2nd Year Internal Marks Mini-Project. Covers Authentication, User, Policyholder, Policy, Claim, ClaimDocument, Review, Settlement, and Summary Reports with JWT Bearer Token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Mehra\",\n  \"email\": \"rohan@example.com\",\n  \"password\": \"Rohan@123\",\n  \"role\": \"Policyholder\",\n  \"phone\": \"+91 99887 76655\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@insurance.edu\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Policyholders",
      "item": [
        {
          "name": "Get All Policyholders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/policyholders?search=&page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "policyholders"] }
          }
        },
        {
          "name": "Create Policyholder Record",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Anand Sharma\",\n  \"dateOfBirth\": \"1991-04-18\",\n  \"gender\": \"Male\",\n  \"address\": \"Sector 15, Rohini, New Delhi - 110085\",\n  \"phone\": \"+91 98101 23456\",\n  \"emergencyContact\": \"+91 98101 99999 (Kavita - Wife)\",\n  \"occupation\": \"Banking Executive\",\n  \"annualIncome\": 950000\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/policyholders", "host": ["{{baseUrl}}"], "path": ["api", "policyholders"] }
          }
        }
      ]
    },
    {
      "name": "3. Policies",
      "item": [
        {
          "name": "Get All Policies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/policies?policyType=Health&status=Active", "host": ["{{baseUrl}}"], "path": ["api", "policies"] }
          }
        },
        {
          "name": "Create Policy",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyholderId\": \"ph_01\",\n  \"policyName\": \"Gold Health Suraksha\",\n  \"policyType\": \"Health\",\n  \"coverageAmount\": 800000,\n  \"premiumAmount\": 15000,\n  \"startDate\": \"2026-03-01\",\n  \"endDate\": \"2027-02-28\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/policies", "host": ["{{baseUrl}}"], "path": ["api", "policies"] }
          }
        }
      ]
    },
    {
      "name": "4. Claims Workflow",
      "item": [
        {
          "name": "Submit Claim",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": \"pol_01\",\n  \"incidentDate\": \"2026-03-10\",\n  \"claimAmount\": 45000,\n  \"reason\": \"Knee arthroscopy diagnostic surgery\",\n  \"description\": \"Daycare procedure conducted under local anesthesia. Discharge certificate attached.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/claims", "host": ["{{baseUrl}}"], "path": ["api", "claims"] }
          }
        },
        {
          "name": "Assign Claim Officer (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"officerId\": \"usr_officer_01\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/claims/clm_02/assign", "host": ["{{baseUrl}}"], "path": ["api", "claims", "clm_02", "assign"] }
          }
        },
        {
          "name": "Submit Officer Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"claimId\": \"clm_02\",\n  \"reviewNotes\": \"Documents verified with hospital billing desk. Expenses verified.\",\n  \"recommendation\": \"Approve\",\n  \"reviewedAmount\": 45000\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api", "reviews"] }
          }
        },
        {
          "name": "Disburse Claim Settlement (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"claimId\": \"clm_02\",\n  \"settlementAmount\": 45000,\n  \"paymentMode\": \"Bank Transfer\",\n  \"transactionId\": \"NEFT-HDFC-2026-992211\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/settlements", "host": ["{{baseUrl}}"], "path": ["api", "settlements"] }
          }
        }
      ]
    },
    {
      "name": "5. Reports",
      "item": [
